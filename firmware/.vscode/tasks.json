{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP32-C3: Build",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/../tools/esp32.ps1", "build"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "ESP32-C3: Flash and Monitor",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/../tools/esp32.ps1", "flash-monitor"],
      "problemMatcher": []
    }
  ]
}
